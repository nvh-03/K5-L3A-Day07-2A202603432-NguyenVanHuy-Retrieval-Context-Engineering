# OpenAI-compatible chat-completions endpoint
OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# For DeepSeek, set OPENAI_MODEL=deepseek-chat and
# OPENAI_BASE_URL=https://api.deepseek.com, then provide:
DEEPSEEK_API_KEY=

# For OpenRouter, set OPENAI_BASE_URL=https://openrouter.ai/api/v1,
# OPENROUTER_MODEL=openai/gpt-4o-mini, and provide:
OPENROUTER_API_KEY=

# For Gemini's OpenAI-compatible API, set OPENAI_BASE_URL to
# https://generativelanguage.googleapis.com/v1beta/openai/ and provide:
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
